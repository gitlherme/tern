    },
    "App": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App"
          }
        }
      }
    },
    "Apps e janelas ocultos não aparecem no seletor. Adicione um app em execução para experimentá-lo: com 5 apps abertos e um oculto, o atalho mostra só os outros 4.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidden apps and windows don’t appear in the switcher. Add a running app to try it: with 5 apps open and one hidden, the shortcut shows only the other 4."
          }
        }
      }
    },
    "Apps ocultos": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidden apps"
          }
        }
      }
    },
    "Atalho global": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Global shortcut"
          }
        }
      }
    },
    "Ative as prévias": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on previews"
          }
        }
      }
    },
    "Atualizações": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updates"
          }
        }
      }
    },
    "Até amanhã": {
      "localizations": {
        "en": {
          "stringUnit": {
