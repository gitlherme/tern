    "Apoiar no Ko-fi": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Support on Ko-fi"
          }
        }
      }
    },
    "Apoiar o Tern…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Support Tern…"
          }
        }
